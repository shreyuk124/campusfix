# Server Configuration
PORT=5000

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/campusfix

# Authentication Secrets
JWT_SECRET=supersecretjwtkey_campusfix_dev
OTP_SECRET=campusfix_otp_hmac_secret_key_change_in_production

# Institutional Email (SMTP) Configuration (e.g. Brevo, Gmail, AWS SES, or University Mail Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_institutional_sender@coeptech.ac.in
SMTP_PASS=your_app_specific_password_or_smtp_token
SMTP_SECURE=false
EMAIL_FROM="CampusFix Verification <noreply@coeptech.ac.in>"

# Cloudinary Configuration (Cloud Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
